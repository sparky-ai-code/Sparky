{
  "name": "sparky-launch-site",
  "private": true,
  "version": "1.1.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "npm run build && node --test site-quality.test.mjs",
    "deploy": "npm run build && npm run deploy:apex && npm run deploy:www",
    "deploy:apex": "npx --yes wrangler@4.114.0 pages deploy dist --project-name=sparky-web --branch=main",
    "deploy:www": "npx --yes wrangler@4.114.0 pages deploy dist --project-name=sparky-website --branch=main"
  },
  "devDependencies": {
    "vite": "^7.0.3"
  }
}
