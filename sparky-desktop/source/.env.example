# Sparky plugin/auth broker. The renderer uses the public Worker URL for the
# isolated Clerk sign-in frame and user-driven plugin status/authorization;
# the local server uses the non-VITE value for agent plugin tools.
# VITE_SPARKY_PLUGIN_WORKER_URL=https://auth.sparky.llc
# SPARKY_PLUGIN_WORKER_URL=https://auth.sparky.llc

# Optional account API used for privacy-safe usage/account metadata. The desktop
# sends the signed-in Clerk JWT; no Clerk secret key is shipped in the app.
# VITE_ACCOUNT_API_URL=https://accounts.example.com
# Server-side account-api configuration belongs in that service's environment:
# CLERK_ISSUER=https://<your-clerk-frontend-api-domain>
# CLERK_JWKS_URL=https://<your-clerk-frontend-api-domain>/.well-known/jwks.json
# CLERK_AUDIENCE=sparky-relay
# Clerk -> Sessions -> Customize session token: {"aud":"sparky-relay"}

# Legacy/public Neon Auth configuration retained for hosted Connect surfaces.
# T3CODE_NEON_AUTH_URL=https://your-neon-auth-endpoint.neon.tech
# T3CODE_NEON_AUTH_OAUTH_AUTHORIZE_URL=https://your-neon-auth-endpoint.neon.tech/oauth/authorize
# T3CODE_NEON_AUTH_CLI_OAUTH_CLIENT_ID=account-cli

# Optional: T3 Connect source builds
# Leave these unset to disable optional T3 Connect features in local source builds.
# Release builds inject their public values at build time. Do not add server-side
# secrets to this file.

# Optional app model-usage analytics endpoint. Use the Convex /analytics/event URL.
# VITE_SPARKY_ANALYTICS_ENDPOINT=https://your-convex-deployment.convex.cloud/analytics/event

# Optional: signed macOS passkey builds. Set these only for a configured passkey RP domain.
# T3CODE_APPLE_TEAM_ID=ABC1234567
# T3CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/sparky.provisionprofile
# T3CODE_NEON_AUTH_PASSKEY_RP_DOMAINS=auth.example.com

# Get this from your relay deployment. `infra/relay` deploys update it automatically.
# T3CODE_RELAY_URL=https://relay.example.com

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Defaults to https://app.t3.codes; override to test against a staging deployment.
# T3CODE_HOSTED_APP_URL=https://nightly.app.t3.codes

# Public, ingest-only mobile OpenTelemetry configuration.
# T3CODE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# T3CODE_MOBILE_OTLP_TRACES_DATASET=t3-code-mobile-traces-dev
# T3CODE_MOBILE_OTLP_TRACES_TOKEN=xaat-...
